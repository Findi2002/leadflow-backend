# =============================================================================
# Project Evergreen — root environment template
# Copy the relevant blocks into backend/.env and frontend/.env.local
# =============================================================================

# ---- backend/.env ----
PORT=4000
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/evergreen
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Optional: leave ANTHROPIC_API_KEY empty for the deterministic, fact-only AI
# fallback that never invents data. Set it to enable live AI summaries.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5-20251001

# ---- frontend/.env.local ----
NEXT_PUBLIC_API_URL=http://localhost:4000
