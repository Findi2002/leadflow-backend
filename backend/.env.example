# --- Project Evergreen — backend environment ---

# HTTP
PORT=4000
FRONTEND_URL=http://localhost:3000

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/evergreen

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# AI support layer (OPTIONAL).
# Leave ANTHROPIC_API_KEY empty to run the deterministic, fact-only fallback
# that never invents data. Set it to enable live AI summaries.
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-4-5-20251001
